        <!-- ══ ROW 4 : FEATURE COMPUTATION ═══════════════════════════════════ -->
        <mxCell id="16"
          value="&lt;b&gt;Komputasi Fitur&lt;/b&gt;&lt;br&gt;&lt;br&gt;eq&amp;nbsp;&amp;nbsp;(256D)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&#x2014; representasi soal / pertanyaan&lt;br&gt;eak (256D)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&#x2014; representasi kunci jawaban&lt;br&gt;ea&amp;nbsp;&amp;nbsp;(256D)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&#x2014; representasi jawaban siswa&lt;br&gt;|eak &#x2212; ea|&amp;nbsp;(256D)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&#x2014; &lt;b&gt;abs_diff&lt;/b&gt; : selisih absolut kunci &#x2013; jawaban&lt;br&gt;eak &#x2299; ea&amp;nbsp;&amp;nbsp;(256D)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&#x2014; &lt;b&gt;had_prod&lt;/b&gt; : Hadamard product kunci &#xD7; jawaban&lt;br&gt;cos(eak, ea)&amp;nbsp;(1D)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&#x2014; &lt;b&gt;cos_sim_ak_a&lt;/b&gt; : kemiripan kunci&#x2013;jawaban&lt;br&gt;cos(eq,&amp;nbsp;ea)&amp;nbsp;&amp;nbsp;(1D)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&#x2014; &lt;b&gt;cos_sim_q_a&lt;/b&gt; : kemiripan soal&#x2013;jawaban&lt;br&gt;1&#x2212;cos(eq,ea) (1D)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&#x2014; &lt;b&gt;orisinalitas&lt;/b&gt; : penalti menyalin soal&lt;br&gt;scalar_feat&amp;nbsp;&amp;nbsp;(32D)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&#x2014; fitur scalar ternormalisasi (coverage, panjang, dsb)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=20;verticalAlign=middle;"
          vertex="1" parent="1">
